{
    "name": "Storage Area Explorer 2",
    "version": "2.0.0",
    "description": "Vanilla JS editor for Storage Area for Chrome Extensions",
    "devtools_page": "app/html/devtoolsBackground.html",
    "background": {
        "service_worker": "app/chrome/background.js"
    },
    "permissions": ["storage", "clipboardRead", "clipboardWrite", "scripting"],
    "host_permissions": ["<all_urls>"],
    "manifest_version": 3
}
