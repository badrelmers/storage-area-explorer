{
    "name": "Storage Area Explorer 2",
    "version": "2.0.0",
    "description": "Vanilla JS editor for Storage Area for Chrome Extensions",
    "devtools_page": "devtoolsBackground.html",
    "background": {
        "service_worker": "background.js"
    },
    "permissions": ["storage", "clipboardRead", "clipboardWrite", "scripting", "tabs"],
    "host_permissions": ["<all_urls>"],
    "manifest_version": 3
}
