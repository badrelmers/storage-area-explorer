{
    "name": "Storage Area Explorer",
    "version": "3.0.0",
    "description": "Simple editor for chrome.storage, localStorage and sessionStorage — no dependencies",
    "devtools_page": "app/html/devtoolsBackground.html",
    "background": {
        "scripts": ["app/chrome/background.js"],
        "persistent": false
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["app/chrome/htmlStorageHook.js"],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "permissions": ["clipboardRead", "clipboardWrite", "<all_urls>"],
    "manifest_version": 2
}
